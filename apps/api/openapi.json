          }
        },
        "required": [
          "externalId",
          "profile",
          "application",
          "test"
        ]
      },
      "BriefProgressDto": {
        "type": "object",
        "properties": {
          "briefId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ]
          }
        },
        "required": [
          "briefId",
          "status"
        ]
      },
      "SimulationProgressDto": {
        "type": "object",
        "properties": {
          "simulationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed"
            ]
          },
          "ending": {
            "type": "string",
            "enum": [
              "completed",
              "stopped"
            ],
            "nullable": true
          }
        },
        "required": [
          "simulationId",
          "status",
          "ending"
        ]
      },
      "AssessmentProgressDto": {
        "type": "object",
        "properties": {
          "assessmentId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ]
          }
        },
        "required": [
          "assessmentId",
          "status"
        ]
      },
      "InterviewProgressDto": {
        "type": "object",
        "properties": {
          "interviewId": {
            "type": "string"
          },
          "transcriptStatus": {
            "type": "string",
            "enum": [
              "none",
              "transcribing",
              "ready",
              "failed"
            ]
          },
          "scoresSaved": {
            "type": "boolean"
          },
          "draftReady": {
            "type": "boolean"
          }
        },
        "required": [
          "interviewId",
          "transcriptStatus",
          "scoresSaved",
          "draftReady"
        ]
      },
      "SurpriseProgressDto": {
        "type": "object",
        "properties": {
          "surpriseId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "started",
              "transcribing",
              "answered",
              "expired",
              "failed"
            ]
          }
        },
        "required": [
          "surpriseId",
          "status"
        ]
      },
      "ConsistencyProgressDto": {
        "type": "object",
        "properties": {
          "before": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ],
            "nullable": true
          },
          "after": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed",
              "locked"
            ],
            "nullable": true
          }
        },
        "required": [
          "before",
          "after"
        ]
      },
      "CandidateProgressDto": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "brief": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/BriefProgressDto"
              }
            ]
          },
          "simulation": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SimulationProgressDto"
              }
            ]
          },
          "assessment": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/AssessmentProgressDto"
              }
            ]
          },
          "interview": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/InterviewProgressDto"
              }
            ]
          },
          "surprise": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SurpriseProgressDto"
              }
            ]
          },
          "consistency": {
            "$ref": "#/components/schemas/ConsistencyProgressDto"
          }
        },
        "required": [
          "candidateId",
          "label",
          "brief",
          "simulation",
          "assessment",
          "interview",
          "surprise",
          "consistency"
        ]
      },
      "CandidateDto": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "progress": {
            "$ref": "#/components/schemas/CandidateProgressDto"
          }
        },
        "required": [
          "candidateId",
          "externalId",
          "label",
          "createdAt"
        ]
      },
