          "answer": {
            "type": "string"
          }
        },
        "required": [
          "fieldId",
          "question",
          "answer"
        ]
      },
      "ApplicationDto": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerDto"
            }
          }
        },
        "required": [
          "answers"
        ]
      },
      "TestAnswerDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        },
        "required": [
          "itemId",
          "response"
        ]
      },
      "TestAnswersDto": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestAnswerDto"
            }
          }
        },
        "required": [
          "answers"
        ]
      },
