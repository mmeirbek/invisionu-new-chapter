          }
        },
        "required": [
          "items"
        ]
      },
      "UpdateAccommodationDto": {
        "type": "object",
        "properties": {
          "textMode": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "textMode",
          "reason"
        ]
      },
      "AccommodationDto": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "textMode": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "setByRole": {
            "type": "string",
            "enum": [
              "commission",
              "admin"
            ]
          },
          "setAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "candidateId",
          "textMode",
          "reason",
          "setByRole",
          "setAt"
        ]
      },
      "ScenarioSummaryDto": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "ready"
            ]
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "D",
                "R",
                "I",
                "V",
                "E"
              ]
            }
          },
          "assignedCount": {
            "type": "number"
          }
        },
        "required": [
          "scenarioId",
          "title",
          "status",
          "competencies",
          "assignedCount"
        ]
      },
      "CreateSimulationDto": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "candidateId"
        ]
      },
      "CharacterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "wants": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "role",
          "wants"
        ]
      },
      "ScenarioBriefDto": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "situation": {
            "type": "string"
          },
          "yourRole": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "character": {
            "$ref": "#/components/schemas/CharacterDto"
          },
          "expectedMinutes": {
            "type": "number"
          },
          "maxCandidateTurns": {
            "type": "number"
          }
        },
        "required": [
          "scenarioId",
          "title",
          "situation",
          "yourRole",
          "goal",
          "character",
          "expectedMinutes",
          "maxCandidateTurns"
        ]
      },
      "TurnDto": {
        "type": "object",
        "properties": {
          "turnId": {
            "type": "string"
          },
          "speaker": {
            "type": "string",
            "enum": [
              "candidate",
              "character"
            ]
          },
          "text": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "turnId",
          "speaker",
          "text",
          "startedAt",
          "endedAt"
        ]
      },
      "SimulationDto": {
        "type": "object",
        "properties": {
          "simulationId": {
            "type": "string"
          },
          "candidateId": {
            "type": "string"
          },
          "scenario": {
            "$ref": "#/components/schemas/ScenarioBriefDto"
          },
          "mode": {
            "type": "string",
            "enum": [
              "voice",
              "text"
            ]
          },
          "accommodation": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "opening",
              "in-progress",
              "wrapping-up",
              "finished"
            ]
          },
          "ending": {
            "type": "string",
            "enum": [
              "completed",
              "stopped"
            ],
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "object",
            "format": "date-time",
            "nullable": true
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TurnDto"
            }
          }
        },
        "required": [
          "simulationId",
          "candidateId",
          "scenario",
          "mode",
          "accommodation",
          "status",
          "stage",
          "ending",
          "startedAt",
          "completedAt",
          "turns"
        ]
      },
      "TextTurnDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "AudioTurnDto": {
        "type": "object",
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary"
