        },
        "required": [
          "candidateTurn",
          "characterTurn",
          "stage",
          "status",
          "candidateTurns",
          "recognitionConfidence",
          "characterAudioUrl"
        ]
      },
      "CompleteSimulationDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "completed",
              "stopped"
            ]
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
