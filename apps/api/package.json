    "@nestjs/platform-express": "11.1.12",
    "@nestjs/swagger": "11.2.6",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.12",
    "@nestjs/testing": "11.1.12",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "30.2.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
