generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApiRole {
  platform
  interviewer
  commission
  admin
}

enum SimulationMode {
  text
  voice
}

enum SimulationStatus {
  active
  completed
}

enum TurnSpeaker {
  candidate
  character
}

model Candidate {
  id                 String       @id @default(uuid()) @db.Uuid
  externalId         String       @unique
  label              String
  profile            Json
  application        Json
  test               Json
  englishCertificate Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  simulations        Simulation[]
  accommodation      Accommodation?
  assessments        Assessment[]
  interviews         Interview[]
  auditEvents        AuditEvent[]
  briefs             Brief[]
  surprise           SurpriseQuestion?
  consistencyReports ConsistencyReport[]
}

model Simulation {
  id         String           @id @default(uuid()) @db.Uuid
  candidateId String           @unique @db.Uuid
  scenarioId String
  scenario   Json?
  mode       SimulationMode
  status     SimulationStatus @default(active)
  stage      String           @default("opening")
  ending     String?
  accommodation Boolean       @default(false)
  turnInFlight Boolean        @default(false)
  createdAt  DateTime         @default(now())
  completedAt DateTime?
  candidate  Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  turns      SimulationTurn[]
  assessment Assessment?
}

model SimulationTurn {
  id           String      @id @default(uuid()) @db.Uuid
  simulationId String      @db.Uuid
  sequence     Int
  speaker      TurnSpeaker
  text         String
  recognitionConfidence Float?
  audioPath    String?
  director     Json?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime    @default(now())
  simulation   Simulation  @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, sequence])
}

model Accommodation {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @unique @db.Uuid
  textMode    Boolean   @default(false)
  reason      String
  setByRole   String
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Assessment {
  id           String     @id @default(uuid()) @db.Uuid
  simulationId String     @unique @db.Uuid
  candidateId  String     @db.Uuid
  status       String     @default("pending")
  result       Json?
  feedback     Json?
  createdAt    DateTime   @default(now())
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  candidate    Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

/// M4: one interview. The transcript arrives from inVision's platform or from a recording made on the
/// interviewer's screen, which is transcribed and then deleted. `interviewerRef` is a pseudonym, never a name.
model Interview {
  id               String             @id @default(uuid()) @db.Uuid
  candidateId      String             @db.Uuid
  interviewerRef   String?
  heldAt           DateTime
  transcriptStatus String             @default("none") // none | transcribing | ready | failed
  transcript       Json?
  transcriptSource String?
  notes            Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  candidate        Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewerScore InterviewerScore?
  drafts           InterviewDraft[]
  consistency      ConsistencyReport[]
  qualityChecks    QualityCheck[]

  @@index([candidateId, createdAt])
}

/// M4: the AI draft, made by the API itself once the transcript exists and the interviewer's scores are
/// saved. It never saw those scores. `result` is ML's DraftResult, stored as returned.
model InterviewDraft {
  id          String    @id @default(uuid()) @db.Uuid
  interviewId String    @db.Uuid
  status      String    @default("pending") // pending | ready | failed
  result      Json?
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
}

model InterviewerScore {
  id          String    @id @default(uuid()) @db.Uuid
  interviewId String    @unique @db.Uuid
  scores      Json
  savedAt     DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

/// M5: a check of how an interview was run, or of one interviewer's scale against the panel's.
/// `result` is the whole QualityCheck the API serves; nothing in it is about a candidate.
model QualityCheck {
  id             String     @id @default(uuid()) @db.Uuid
  kind           String     // interview | calibration
  interviewId    String?    @db.Uuid
  interviewerRef String?
  result         Json
  createdAt      DateTime   @default(now())
  interview      Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
}

model AuditEvent {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String?   @db.Uuid
  actorRole   ApiRole?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([candidateId])
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  requestHash String
  statusCode  Int
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

/// M1: the interviewer's brief. Made by the API itself — when the candidate arrives and again once the
/// simulation is assessed — so every step has one. `result` is ML's BriefResult, stored as returned.
model Brief {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @db.Uuid
  status      String    @default("pending") // pending | ready | failed
  result      Json?
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

/// S: one unexpected question about the candidate's own application, one attempt, 90 seconds on camera.
/// The question is written by ML when it is created and revealed only by `start`. The video stays on disk
/// for staff only (`videoRef`); only the transcript of its audio ever reaches a model.
model SurpriseQuestion {
  id             String    @id @default(uuid()) @db.Uuid
  candidateId    String    @unique @db.Uuid
  status         String    @default("ready") // ready | started | transcribing | answered | expired | failed
  question       String
  competency     String
  why            String
  answerSeconds  Int       @default(90)
  startedAt      DateTime?
  answerDeadline DateTime?
  videoRef       String?
  segments       Json?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

/// C, after the interview: what the candidate claimed against what was measured and what the interview
/// showed. Made by the API itself once the transcript exists and the interviewer's scores are saved —
/// it reads the interview, so it waits for the blind scores like the draft. The before stage is the
/// brief's own `consistency` block. `result` is ML's ConsistencyResult, stored as returned.
model ConsistencyReport {
  id          String     @id @default(uuid()) @db.Uuid
  candidateId String     @db.Uuid
  interviewId String?    @db.Uuid
  status      String     @default("pending") // pending | ready | failed
  result      Json?
  createdAt   DateTime   @default(now())
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interview   Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
}
