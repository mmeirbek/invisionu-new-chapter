        "additionalProperties": false,
        "type": "object",
        "required": [
          "beat",
          "nextBeat",
          "reason"
        ],
        "title": "DirectorDecision"
      },
      "DriveScore": {
        "properties": {
          "competency": {
            "type": "string",
            "enum": [
              "D",
              "R",
              "I",
              "V",
              "E"
            ],
            "title": "Competency"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "competency",
          "score",
          "confidence",
          "rationale",
          "evidence"
        ],
        "title": "DriveScore"
      },
      "EnglishCertificate": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "score": {
            "type": "string",
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "score"
        ],
        "title": "EnglishCertificate"
      },
      "EnglishMetrics": {
        "properties": {
          "wordsPerMinute": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wordsperminute"
          },
          "fillerRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fillerrate"
          },
          "meanTurnLength": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meanturnlength"
          },
          "lexicalDiversity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lexicaldiversity"
          },
          "grammarErrorsPer100Words": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grammarerrorsper100Words"
          },
          "cefrEstimate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cefrestimate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "wordsPerMinute",
          "fillerRate",
          "meanTurnLength",
          "lexicalDiversity",
          "grammarErrorsPer100Words",
          "cefrEstimate"
        ],
        "title": "EnglishMetrics"
      },
      "Evidence": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "application_field",
              "test_item",
              "simulation_turn",
              "interview_turn",
              "interview_note",
              "surprise_answer"
            ],
            "title": "Source"
          },
          "sourceId": {
            "type": "string",
            "title": "Sourceid"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "sourceId",
          "quote"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "InterviewQuestion": {
        "properties": {
          "competency": {
            "type": "string",
            "enum": [
              "D",
              "R",
              "I",
              "V",
              "E"
            ],
            "title": "Competency"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "competency",
          "question",
          "reason"
