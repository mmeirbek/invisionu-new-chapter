            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenarioId",
          "turns"
        ],
        "title": "TurnRequest"
      },
      "TurnResult": {
        "properties": {
          "text": {
            "type": "string",
