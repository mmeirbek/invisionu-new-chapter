          },
          "stage": {
            "type": "string",
            "enum": [
              "opening",
              "in-progress",
              "wrapping-up",
              "finished"
            ],
            "title": "Stage"
          },
          "ended": {
            "type": "boolean",
            "title": "Ended"
          },
          "director": {
            "$ref": "#/components/schemas/DirectorDecision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "stage",
          "ended",
          "director"
        ],
        "title": "TurnResult"
      },
      "TurnState": {
        "properties": {
          "beat": {
            "type": "string",
