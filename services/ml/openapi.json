        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "certificate",
          "writtenCefr",
          "basis"
        ],
        "title": "BriefEnglish"
      },
      "BriefFlag": {
        "properties": {
          "title": {
            "type": "string",
