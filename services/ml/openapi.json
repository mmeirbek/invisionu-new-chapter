          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "ask",
          "sources"
        ],
        "title": "BriefFlag"
      },
      "BriefQuestion": {
        "properties": {
          "competency": {
            "type": "string",
            "enum": [
              "D",
              "R",
              "I",
              "V",
              "E"
            ],
            "title": "Competency"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "why": {
            "type": "string",
            "title": "Why"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "competency",
          "question",
          "why",
          "evidence"
        ],
        "title": "BriefQuestion"
      },
      "BriefRequest": {
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/CandidateView"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate"
        ],
        "title": "BriefRequest"
      },
      "BriefResult": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/BriefQuestion"
            },
            "type": "array",
            "title": "Questions"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/BriefFlag"
            },
            "type": "array",
            "title": "Flags"
          },
          "clarify": {
            "items": {
              "$ref": "#/components/schemas/BriefTopic"
            },
            "type": "array",
            "title": "Clarify"
          },
          "english": {
            "$ref": "#/components/schemas/BriefEnglish"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "questions",
          "flags",
          "clarify",
          "english"
