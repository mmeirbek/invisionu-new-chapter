      },
      "DirectorDecision": {
        "properties": {
          "beat": {
            "type": "string",
            "title": "Beat"
          },
          "nextBeat": {
            "type": "string",
            "title": "Nextbeat"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
