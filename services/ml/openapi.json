        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidateId",
          "application",
          "test"
        ],
        "title": "CandidateView"
      },
      "CertificateLevel": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "score": {
            "type": "string",
            "title": "Score"
          },
          "cefr": {
            "type": "string",
            "title": "Cefr"
