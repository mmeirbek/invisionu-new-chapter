        "title": "BriefResult"
      },
      "BriefTopic": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topic",
          "evidence"
        ],
        "title": "BriefTopic"
      },
      "CandidateFeedback": {
        "properties": {
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths"
          },
          "growth": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Growth"
          },
          "nextTime": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Nexttime"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "strengths",
          "growth",
          "nextTime"
        ],
        "title": "CandidateFeedback",
        "description": "The only text the candidate reads: no score, no number, no decision wording."
      },
      "CandidateView": {
        "properties": {
          "candidateId": {
            "type": "string",
            "title": "Candidateid"
          },
          "application": {
            "$ref": "#/components/schemas/Answers"
          },
          "test": {
            "$ref": "#/components/schemas/TestAnswers"
