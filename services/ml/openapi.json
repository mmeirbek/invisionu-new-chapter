        "title": "InterviewQuestion"
      },
      "TestAnswer": {
        "properties": {
          "itemId": {
            "type": "string",
            "title": "Itemid"
          },
          "response": {
            "type": "string",
            "title": "Response"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "itemId",
          "response"
        ],
        "title": "TestAnswer"
      },
      "TestAnswers": {
        "properties": {
          "answers": {
            "items": {
              "$ref": "#/components/schemas/TestAnswer"
            },
            "type": "array",
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "TestAnswers"
      },
      "Turn": {
        "properties": {
          "turnId": {
            "type": "string",
            "pattern": "^turn_\\d{2,}$",
            "title": "Turnid"
          },
          "speaker": {
            "type": "string",
            "enum": [
              "candidate",
              "character"
            ],
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "startedAt": {
            "type": "string",
            "title": "Startedat"
          },
          "endedAt": {
            "type": "string",
            "title": "Endedat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "turnId",
          "speaker",
          "text",
          "startedAt",
          "endedAt"
        ],
        "title": "Turn"
      },
      "TurnRequest": {
        "properties": {
          "scenarioId": {
            "type": "string",
            "title": "Scenarioid"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array",
            "title": "Turns"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TurnState"
