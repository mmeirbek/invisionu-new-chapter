# Copy to .env and fill in. Never commit .env.

# Providers — keys are held by the tech lead
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Gateway
# live    — call the providers
# record  — call the providers and save every response to fixtures/cassettes
# replay  — answer only from fixtures/cassettes, never touch the network
GATEWAY_MODE=replay
BUDGET_USD_CAP=20
USAGE_LOG_PATH=/data/gateway-usage.jsonl
DEMO_MODE=false
# Only when ml runs outside Docker, where its image sets both:
# the MiniLM model for the scenario matcher, and LanguageTool for the English metrics
M2_EMBEDDING_MODEL_PATH=/opt/models/all-MiniLM-L6-v2
M3_LANGUAGETOOL_DIR=/opt/languagetool/LanguageTool-6.6

# Web
# The stand (inVision's own screens) still runs on mocks in the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_MODE=mock
# Product screens call /api/v1/* on the web server, which adds the key below for
# the demo role in the cookie. These never reach the browser, so no NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:3001
WEB_API_KEY_PLATFORM=change-me-platform
WEB_API_KEY_INTERVIEWER=change-me-interviewer
WEB_API_KEY_COMMISSION=change-me-commission
WEB_API_KEY_ADMIN=change-me-admin

# API
DATABASE_URL=postgresql://invision:invision@localhost:5432/invision
# Demo clients, key:role pairs. Replace the values; never reuse these outside a laptop.
API_KEYS=change-me-platform:platform,change-me-interviewer:interviewer,change-me-commission:commission,change-me-admin:admin
ML_SERVICE_URL=http://localhost:8000
# Candidate videos are deleted this many days after the decision date inVision reports.
VIDEO_RETENTION_DAYS=30

# Shared by api and ml
ML_INTERNAL_TOKEN=change-me
# A volume both mount at this path; audioRef in ML requests is relative to it
UPLOADS_DIR=/data/uploads
