# Copy to .env and fill in. Never commit .env.

# Providers — keys are held by the tech lead
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Gateway
# live    — call the providers
# record  — call the providers and save every response to fixtures/cassettes
# replay  — answer only from fixtures/cassettes, never touch the network
GATEWAY_MODE=live
BUDGET_USD_CAP=20
DEMO_MODE=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_MODE=mock

# API
DATABASE_URL=postgresql://invision:invision@localhost:5432/invision
# Demo clients, key:role pairs. Replace the values; never reuse these outside a laptop.
API_KEYS=change-me-platform:platform,change-me-interviewer:interviewer,change-me-commission:commission,change-me-admin:admin
ML_SERVICE_URL=http://localhost:8000

# Shared by api and ml
ML_INTERNAL_TOKEN=change-me
# A volume both mount at this path; audioRef in ML requests is relative to it
UPLOADS_DIR=/data/uploads
