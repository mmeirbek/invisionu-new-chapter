# Copy to .env and fill in. Never commit .env.

# Providers — keys are held by the tech lead
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Gateway
# live    — call the providers
# record  — call the providers and save every response to fixtures/cassettes
# replay  — answer only from fixtures/cassettes, never touch the network
# offline — use the local model (Ollama) and local speech recognition
GATEWAY_MODE=live
BUDGET_USD_CAP=20
DEMO_MODE=false

# Services
DATABASE_URL=postgresql://invision:invision@localhost:5432/invision
ML_SERVICE_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434
